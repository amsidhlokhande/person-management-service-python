# Copy this file to .env, then replace credentials and signing keys.
# Active profile: DEV, UAT, or PROD. Only that profile's settings are loaded.
SPRING_PROFILES_ACTIVE=DEV

# ---------------------------------------------------------------------------
# DEV profile - local development defaults
# ---------------------------------------------------------------------------
# Comma-separated database client names activated for this profile.
DEV_DATABASE_CLIENTS=primary
# To enable a second SQLite client, use "primary,reporting" and define
# DEV_REPORTING_DATABASE_URL with its own SQLAlchemy SQLite URL.
# Database client used by the person repository; defaults to the first name.
DEV_PRIMARY_DATABASE_CLIENT=primary
# Named client's SQLAlchemy URL. In-memory SQLite resets on service restart.
DEV_PRIMARY_DATABASE_URL=sqlite:///:memory:
# JWT signing key; use a unique value outside local development.
DEV_JWT_SECRET=replace-this-development-secret
# HMAC algorithm used to sign and verify JWTs.
DEV_JWT_ALGORITHM=HS256
# Access-token lifetime in minutes.
DEV_ACCESS_TOKEN_MINUTES=30
# Refresh-token lifetime in days.
DEV_REFRESH_TOKEN_DAYS=7
# Username accepted by the token endpoint.
DEV_AUTH_USERNAME=admin
# Password accepted by the token endpoint; replace before use.
DEV_AUTH_PASSWORD=change-me
# Seed the sample Ada Lovelace person at startup when true.
DEV_SEED_DATA=true

# ---------------------------------------------------------------------------
# UAT profile - use isolated UAT credentials and datastore
# ---------------------------------------------------------------------------
# Comma-separated database client names activated for this profile.
UAT_DATABASE_CLIENTS=primary
# Additional client names require a matching UAT_<NAME>_DATABASE_URL property.
# Database client used by the person repository.
UAT_PRIMARY_DATABASE_CLIENT=primary
# Named client's SQLAlchemy URL for UAT data.
UAT_PRIMARY_DATABASE_URL=sqlite:///./person_management_uat.db
# Unique private signing key for UAT tokens.
UAT_JWT_SECRET=replace-with-a-unique-uat-secret
# HMAC algorithm used to sign and verify UAT JWTs.
UAT_JWT_ALGORITHM=HS256
# UAT access-token lifetime in minutes.
UAT_ACCESS_TOKEN_MINUTES=30
# UAT refresh-token lifetime in days.
UAT_REFRESH_TOKEN_DAYS=7
# Username accepted by the UAT token endpoint.
UAT_AUTH_USERNAME=admin
# UAT password; replace with a unique secret.
UAT_AUTH_PASSWORD=change-me

# ---------------------------------------------------------------------------
# PROD profile - supply real values via deployment secret management
# ---------------------------------------------------------------------------
# Comma-separated database client names activated for this profile.
PROD_DATABASE_CLIENTS=primary
# Additional client names require a matching PROD_<NAME>_DATABASE_URL property.
# Database client used by the person repository.
PROD_PRIMARY_DATABASE_CLIENT=primary
# Named client's SQLAlchemy URL for production data.
PROD_PRIMARY_DATABASE_URL=sqlite:///./person_management.db
# Unique production JWT key of at least 32 characters.
PROD_JWT_SECRET=replace-with-a-unique-production-secret
# HMAC algorithm used to sign and verify production JWTs.
PROD_JWT_ALGORITHM=HS256
# Production access-token lifetime in minutes.
PROD_ACCESS_TOKEN_MINUTES=15
# Production refresh-token lifetime in days.
PROD_REFRESH_TOKEN_DAYS=7
# Username accepted by the production token endpoint.
PROD_AUTH_USERNAME=admin
# Production password; provide a strong value through a secret manager.
PROD_AUTH_PASSWORD=change-me
